# NORVAULT Environment Variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://norvault:norvault@localhost:5432/norvault

# Brønnøysundregistrene API
BRREG_BASE_URL=https://data.brreg.no

# Request Budget
MAX_REQUESTS=2000
MAX_COST=10.00

# Logging
LOG_LEVEL=INFO

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000
